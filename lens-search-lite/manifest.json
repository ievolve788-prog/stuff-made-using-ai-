{
  "manifest_version": 3,
  "name": "Lens Search Lite",
  "version": "1.1.0",
  "description": "Search any image, the full page, or a selected area with Google Lens, and jump into Google AI Mode (side panel or tab) with your own default prompt. No tracking, no paywall.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "contextMenus",
    "declarativeNetRequest",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://lens.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "search_screen": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Search the full visible page with Google Lens"
    },
    "search_area": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Select an area of the page to search with Google Lens"
    },
    "open_ai_mode": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open Google AI Mode (sends your default prompt)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://lens.google.com/*"
      ],
      "js": [
        "lens-inject.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/*",
        "https://lens.google.com/*"
      ],
      "js": [
        "ai-mode.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
