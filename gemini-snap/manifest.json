{
  "manifest_version": 3,
  "name": "Gemini Snap",
  "version": "1.3.0",
  "description": "Capture (crop / visible / full page) and send to Gemini with an editable prompt and preset templates.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemini Snap",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "capture-region": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Select an area and send it to Gemini"
    },
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Capture visible screen and send to Gemini"
    },
    "quick-send": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "Quick send: capture visible screen and send to Gemini instantly (no prompt, auto-Enter)"
    },
    "capture-full": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Capture full page (scrolling) and send to Gemini"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "116"
}