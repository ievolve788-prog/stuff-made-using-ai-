{
  "manifest_version": 3,
  "name": "Typexpand",
  "version": "1.3.0",
  "description": "Espanso-style text expander for the browser. Types (or pastes) snippets when you type a trigger, and can type your clipboard.",
  "permissions": [
    "storage",
    "clipboardRead",
    "contextMenus",
    "offscreen",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Typexpand",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "type-clipboard": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Type the clipboard contents (keystroke by keystroke)"
    },
    "paste-clipboard": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Paste the clipboard contents instantly"
    },
    "copy-log": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Copy the Typexpand debug log to the clipboard"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}