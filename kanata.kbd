 
(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  lctl lsft lmet lalt ralt rctl rsft caps spc c s d f e h j k l , u i o pgdn mwu mwd mlft mrgt
)

(defvar
  tap-time 200
)

(defalias
  ;; --- Physical Modifier One-Shot Aliases (Single Tap = OSM) ---
  os-lctl (one-shot-press-pcancel 2000 lctl)
  os-lsft (one-shot-press-pcancel 2000 lsft)
  os-lmet (one-shot-press-pcancel 2000 lmet)
  os-lalt (one-shot-press-pcancel 2000 lalt)
  os-rsft (one-shot-press-pcancel 2000 rsft)

  ;; --- Smooth Mouse Wheel Scrolling ---
  ;; Parameters: (mwheel-direction interval_ms distance_units)
  mau (mwheel-up 50 120)
  mad (mwheel-down 50 120)

  ;; --- Right Alt Action ---
  ;; Single Tap = Copy (C-c), Double Tap = Cut (C-x)
  ralt-copy-cut (tap-dance $tap-time (C-c C-x))

  ;; --- Right Ctrl Action ---
  ;; Single Tap = Paste (C-v), Hold = Volume Layer
  rctl-vol (tap-hold-press $tap-time $tap-time C-v (layer-toggle volume))

  ;; --- Spacebar Action ---
  ;; Tap = Space, Hold = Mouse / Navigation Layer
  spc-mouse (tap-hold 150 200 spc (layer-toggle mouse))

  ;; --- Toggle Normal / Passthrough Layer ---
  toggle-passthrough (switch
    ((base-layer passthrough)) (layer-switch base) break
    () (layer-switch passthrough) break
  )

  ;; Toggle PageDown lock
  toggle-pgdn (on-press toggle-vkey pgdn-vk)

  ;; Smart PageDown
  pgdn-action (switch
    ((and (or (input real lctl) (input real rctl) (input real f) (input real j))
          (or (input real lsft) (input real rsft) (input real d) (input real k)))) @toggle-pgdn break
    () pgdn break
  )
)

;; Primary Base Layer
(deflayer base
  @os-lctl @os-lsft @os-lmet @os-lalt @ralt-copy-cut @rctl-vol @os-rsft mlft @spc-mouse c s d f e h j k l , u i o @pgdn-action mwu mwd mlft mrgt
)

;; Dedicated Mouse & Navigation Layer (Active ONLY while holding Spacebar)
(deflayer mouse
  _ _ _ _ _ _ _ _ _ @mad mlft mrgt _ @mau left down up rght _ _ _ _ _ _ _ _ _
)

;; Dedicated Volume Control Layer (Active ONLY while holding Right Ctrl)
(deflayer volume
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ volu voldwn _ _
)

;; 100% Normal Keyboard Layer (Zero Kanata Remappings / Pure Passthrough)
(deflayer passthrough
  lctl lsft lmet lalt ralt rctl rsft caps spc c s d f e h j k l , u i o pgdn mwu mwd mlft mrgt
)

(defvirtualkeys
  pgdn-vk pgdn
)

(defchordsv2
  ;; Press U + I + O simultaneously to toggle Normal Passthrough Mode ON/OFF
  (u i o) @toggle-passthrough 200 first-release ()
)
