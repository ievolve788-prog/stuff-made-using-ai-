(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  grv f1 f2 f3 f4 lctl lsft lmet lalt rsft caps spc w e a s d f g z x c v h j k l , u i o pgdn mwu mwd mlft mrgt
)

(defvar
  tap-time 200
)

(defalias
  ;; --- Function Row Toolbar ---
  ;; Tap = Copy (C-c), Hold = Normal F1
  f1-copy (tap-hold-press 150 200 C-c f1)
  ;; Tap = Paste (C-v), Hold = Normal F2
  f2-paste (tap-hold-press 150 200 C-v f2)
  ;; Tap = Select All (C-a), Hold = Normal F3
  f3-all  (tap-hold-press 150 200 C-a f3)
  ;; Tap = Alt+Tab (A-tab), Hold = Normal F4
  f4-tab  (tap-hold-press 150 200 A-tab f4)

  ;; --- Grave Key Dual-Role ---
  ;; Tap = Right Click (mrgt), Hold = Normal Grave/Backtick (grv)
  grv-rclick (tap-hold-press 150 200 mrgt grv)

  ;; --- Physical Modifier One-Shot Aliases (Single Tap = OSM) ---
  os-lctl (one-shot-press-pcancel 2000 lctl)
  os-lsft (one-shot-press-pcancel 2000 lsft)
  os-lmet (one-shot-press-pcancel 2000 lmet)
  os-lalt (one-shot-press-pcancel 2000 lalt)
  os-rsft (one-shot-press-pcancel 2000 rsft)

  ;; --- Smooth Mouse Wheel Scrolling ---
  mau (mwheel-up 50 120)
  mad (mwheel-down 50 120)

  ;; --- Spacebar Action ---
  ;; Tap = Space, Hold = Mouse / Navigation / Clipboard Layer
  spc-mouse (tap-hold 150 200 spc (layer-toggle mouse))

  ;; --- Mouse Drag Toggle (Space + G) ---
  toggle-drag (on-press toggle-vkey drag-vk)

  ;; Toggle PageDown lock
  toggle-pgdn (on-press toggle-vkey pgdn-vk)

  ;; Smart PageDown
  pgdn-action (switch
    ((and (or (input real lctl) (input real rctl) (input real f) (input real j))
          (or (input real lsft) (input real rsft) (input real d) (input real k)))) @toggle-pgdn break
    () pgdn break
  )
)

;; Primary Base Layer (36 items)
(deflayer base
  @grv-rclick @f1-copy @f2-paste @f3-all @f4-tab @os-lctl @os-lsft @os-lmet @os-lalt @os-rsft mlft @spc-mouse w e a s d f g z x c v h j k l , u i o @pgdn-action mwu mwd mlft mrgt
)

;; Dedicated Mouse, Navigation & Clipboard Layer (Active ONLY while holding Spacebar) (36 items)
;; W / E = Scroll Up / Down
;; A = esc, S = Left Click, D = Right Click, F = ret, G = Toggle Drag
;; Z = Select All, X = Cut, C = Copy, V = Paste
;; H / J / K / L = Arrow keys
(deflayer mouse
  _ _ _ _ _ _ _ _ _ _ _ _ @mau @mad esc mlft mrgt ret @toggle-drag C-a C-x C-c C-v left down up rght _ _ _ _ _ _ _ _ _
)

(defvirtualkeys
  pgdn-vk pgdn
  drag-vk mlft
)
