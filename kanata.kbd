(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  grv f1 f2 lctl lsft lmet lalt ralt rctl rsft caps spc w e a s d f g x c v h j k l , u i o pgdn mwu mwd mlft mrgt
)

(defvar
  tap-time 200
)

(defalias
  ;; --- F1 and F2 Clipboard Shortcuts ---
  ;; Tap = Copy (C-c), Hold = Normal F1
  f1-copy (tap-hold-press 150 200 C-c f1)
  ;; Tap = Paste (C-v), Hold = Normal F2
  f2-paste (tap-hold-press 150 200 C-v f2)

  ;; --- Grave Key Dual-Role ---
  ;; Tap = Right Click (mrgt), Hold = Normal Grave/Backtick (grv)
  grv-rclick (tap-hold-press 150 200 mrgt grv)

  ;; --- Physical Modifier One-Shot Aliases (Single Tap = OSM) ---
  os-lctl (one-shot-press-pcancel 2000 lctl)
  os-lsft (one-shot-press-pcancel 2000 lsft)
  os-lmet (one-shot-press-pcancel 2000 lmet)
  os-lalt (one-shot-press-pcancel 2000 lalt)
  os-rsft (one-shot-press-pcancel 2000 rsft)

  ;; --- Smooth Mouse Wheel Scrolling ---
  mau (mwheel-up 50 120)
  mad (mwheel-down 50 120)

  ;; --- Right Alt Action ---
  ;; Single Tap = Copy (C-c), Double Tap = Cut (C-x)
  ralt-copy-cut (tap-dance $tap-time (C-c C-x))

  ;; --- Right Ctrl Action ---
  ;; Single Tap = Paste (C-v), Hold = Volume Layer
  rctl-vol (tap-hold-press $tap-time $tap-time C-v (layer-toggle volume))

  ;; --- Spacebar Action ---
  ;; Tap = Space, Hold = Mouse / Navigation / Clipboard Layer
  spc-mouse (tap-hold 150 200 spc (layer-toggle mouse))

  ;; --- Mouse Drag Toggle (Space + G) ---
  toggle-drag (on-press toggle-vkey drag-vk)

  ;; --- Toggle Normal / Passthrough Layer ---
  toggle-passthrough (switch
    ((base-layer passthrough)) (layer-switch base) break
    () (layer-switch passthrough) break
  )

  ;; Toggle PageDown lock
  toggle-pgdn (on-press toggle-vkey pgdn-vk)

  ;; Smart PageDown
  pgdn-action (switch
    ((and (or (input real lctl) (input real rctl) (input real f) (input real j))
          (or (input real lsft) (input real rsft) (input real d) (input real k)))) @toggle-pgdn break
    () pgdn break
  )
)

;; Primary Base Layer (35 items)
(deflayer base
  @grv-rclick @f1-copy @f2-paste @os-lctl @os-lsft @os-lmet @os-lalt @ralt-copy-cut @rctl-vol @os-rsft mlft @spc-mouse w e a s d f g x c v h j k l , u i o @pgdn-action mwu mwd mlft mrgt
)

;; Dedicated Mouse, Navigation & Clipboard Layer (Active ONLY while holding Spacebar) (35 items)
;; W / E = Scroll Up / Down
;; A = esc, S = Left Click, D = Right Click, F = ret, G = Toggle Drag
;; X = Cut, C = Copy, V = Paste
;; H / J / K / L = Arrow keys
(deflayer mouse
  _ _ _ _ _ _ _ _ _ _ _ _ @mau @mad esc mlft mrgt ret @toggle-drag C-x C-c C-v left down up rght _ _ _ _ _ _ _ _ _
)

;; Dedicated Volume Control Layer (Active ONLY while holding Right Ctrl) (35 items)
(deflayer volume
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ volu voldwn _ _
)

;; 100% Normal Keyboard Layer (Zero Kanata Remappings / Pure Passthrough) (35 items)
(deflayer passthrough
  grv f1 f2 lctl lsft lmet lalt ralt rctl rsft caps spc w e a s d f g x c v h j k l , u i o pgdn mwu mwd mlft mrgt
)

(defvirtualkeys
  pgdn-vk pgdn
  drag-vk mlft
)

(defchordsv2
  ;; Press U + I + O simultaneously to toggle Normal Passthrough Mode ON/OFF
  (u i o) @toggle-passthrough 200 first-release ()
)
