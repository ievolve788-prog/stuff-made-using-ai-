// ==UserScript==
// @name         YouTube Fullscreen Race-Condition Guard
// @namespace    http://tampermonkey.net/
// @version      2026-10-28
// @description  Blocks 'f' shortcut until video metadata and frame are ready
// @author       You
// @match        https://www.youtube.com/*
// @icon         https://www.google.com/s2/favicons?sz=64&domain=youtube.com
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function() {
    'use strict';

    const DEBUG = true; // Debug messages console me dekhne ke liye true rakhein

    function log(msg, data = '') {
        if (DEBUG) console.log(`[YT-FS-Guard] ${msg}`, data);
    }

    window.addEventListener('keydown', (e) => {
        // Sirf tab act kare jab 'f' bina modifier keys ke dabaya gaya ho
        if (e.key.toLowerCase() !== 'f' || e.ctrlKey || e.altKey || e.metaKey) return;

        // Input fields aur contenteditable (comments/search) check
        const active = document.activeElement;
        const isEditable = active && (
            ['INPUT', 'TEXTAREA'].includes(active.tagName) ||
            active.isContentEditable ||
            active.getAttribute('role') === 'textbox'
        );

        if (isEditable) return;

        const v = document.querySelector('video');

        // readyState < 2 matlab HAVE_CURRENT_DATA abhi nahi mila
        if (!v || v.readyState < 2) {
            e.stopImmediatePropagation();
            e.preventDefault();
            log('Blocked premature "f" press! Video state:', v ? `readyState=${v.readyState}` : 'video element missing');
        } else {
            log('Allowed "f" press. Video readyState:', v.readyState);
        }
    }, true);
})();
